# Supabase (public, safe to expose to the browser).
# Copy this file to `.env.local` and fill in the real values — `.env.local` is
# git-ignored (see `.env*` in .gitignore). Without these two variables the app
# runs in demo mode: no auth redirects, forms/data fall back to local demo data.
#
# Project URL:        Supabase Dashboard -> Project Settings -> API -> Project URL
# Publishable key:    Supabase Dashboard -> Project Settings -> API Keys -> Publishable key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy projects only: the old anon key is accepted as a fallback when
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
